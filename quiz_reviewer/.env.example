# Copy this file to ".env" and fill in your values.  The .env file is ignored
# by git (see .gitignore) so your secret key never gets uploaded by accident.

# Your OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: which model to use (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Set to 1 to practise WITHOUT an API key: the app returns a built-in sample
# response instead of calling OpenAI.
FAKE_AI=1

# Optional: Django's signing key. Leave empty for the workshop.
DJANGO_SECRET_KEY=
